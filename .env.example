# Copy to .env.local and use only the NEW personal Firebase project's values.
# Leaving all values empty keeps local-only mode. Partial setup blocks access.
VITE_LEDGER_SYNC_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Exactly one UID, from Authentication > Users in the personal Firebase project.
VITE_FIREBASE_ALLOWED_UIDS=
